{
	"name": "Dollchan Next",
	"version": "1.0.0",
	"description": "A modern, privacy-conscious imageboard companion for Firefox and Zen.",
	"homepage_url": "https://github.com/qqrm/Dollchan-Next",
	"short_name": "Dollchan Next",
	"manifest_version": 2,

	"browser_specific_settings": {
		"gecko": {
			"id": "dollchan-next@qqrm.github.io",
			"strict_min_version": "140.0",
			"data_collection_permissions": {
				"required": [
					"personalCommunications",
					"browsingActivity",
					"websiteContent"
				]
			}
		},
		"gecko_android": {
			"strict_min_version": "142.0"
		}
	},
	"background": {
		"scripts": ["background.js"]
	},
	"browser_action": {
		"browser_style": false,
		"default_icon": {
			"16": "icons/dn-16.png",
			"32": "icons/dn-32.png",
			"48": "icons/dn-48.png"
		},
		"default_title": "Dollchan Next",
		"default_popup": "menu/menu.html"
	},
	"icons": {
		"16": "icons/dn-16.png",
		"32": "icons/dn-32.png",
		"48": "icons/dn-48.png",
		"64": "icons/dn-64.png",
		"96": "icons/dn-96.png",
		"128": "icons/dn-128.png",
		"256": "icons/dn-256.png"
	},
	"options_ui": {
		"page": "settings/settings.html",
		"open_in_tab": true
	},
	"permissions": [
		"<all_urls>",
		"notifications",
		"storage",
		"tabs",
		"unlimitedStorage",
		"webNavigation"
	]
}
